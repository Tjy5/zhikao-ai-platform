[flake8]
max-line-length = 88
extend-ignore = 
    # E203: whitespace before ':'
    E203,
    # W503: line break before binary operator
    W503,
    # E501: line too long (handled by black)
    E501
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    .mypy_cache,
    .pytest_cache,
    migrations,
    alembic/versions,
    build,
    dist
per-file-ignores = 
    # F401: imported but unused (common in __init__.py)
    __init__.py:F401
    # F403: star import (sometimes needed for exports)
    __init__.py:F403
max-complexity = 12
import-order-style = google

