# Java backend development environment
BACKEND_PORT=8001
JDBC_DATABASE_URL=jdbc:sqlite:./dev.db

# Comma-separated frontend origins allowed by CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security secrets. Replace both in every non-local environment.
APP_SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
MODEL_SETTINGS_ENCRYPTION_KEY=dev-only-model-settings-key-change-me

# OpenAI-compatible defaults used before each user saves their own settings
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini
WRITING_LLM_JSON_FALLBACK=true

DEBUG=false
