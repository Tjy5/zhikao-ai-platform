# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# Writing LLM JSON Fallback
# When enabled (default true), if structured output fails (e.g., provider doesn't
# support SDK-level Structured Outputs), the provider will retry with a plain
# chat-completion JSON instruction and local parsing + Pydantic validation.
# Set to "false" to disable and fall back directly to rule-based grading.
WRITING_LLM_JSON_FALLBACK=true

# Database Configuration
DATABASE_URL=sqlite:///./dev.db

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication
# Use a long random value in production and keep it out of source control.
APP_SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Per-user model settings encryption
# Back this value up before production use; losing it makes stored provider keys unrecoverable.
MODEL_SETTINGS_ENCRYPTION_KEY=dev-only-model-settings-key-change-me

# Debug Mode
DEBUG=True

# Prevent Python from writing .pyc files
PYTHONDONTWRITEBYTECODE=1
